# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Build the app for testing"
  lane :build do
    build_app(
      scheme: "BalloonPop",
      configuration: "Debug",
      skip_package_ipa: true,
      skip_archive: true
    )
  end

  desc "Run tests"
  lane :test do
    run_tests(
      scheme: "BalloonPop",
      devices: ["iPhone 16 Pro"]
    )
  end

  desc "Build a release version of the app"
  lane :build_release do
    build_app(
      scheme: "BalloonPop",
      configuration: "Release",
      export_method: "development"
    )
  end

  desc "Take screenshots"
  lane :screenshots do
    capture_screenshots(
      scheme: "BalloonPop"
    )
  end

  desc "Increment build number"
  lane :bump_build do
    increment_build_number(
      xcodeproj: "BalloonPop.xcodeproj"
    )
  end

  desc "Increment version number (patch)"
  lane :bump_version do
    increment_version_number(
      bump_type: "patch",
      xcodeproj: "BalloonPop.xcodeproj"
    )
  end

  # Certificate and Provisioning Profile Management with Match
  #
  # IMPORTANT: Before using Match lanes, create a private Git repository
  # and set the MATCH_GIT_URL environment variable or update the lanes below.
  # Example: export MATCH_GIT_URL="https://github.com/yourusername/certificates"

  desc "Setup Match (first time only)"
  lane :setup_match do
    UI.user_error!("Please set MATCH_GIT_URL environment variable first!") unless ENV["MATCH_GIT_URL"]

    match(
      git_url: ENV["MATCH_GIT_URL"],
      type: "appstore",
      app_identifier: "net.cmuis.BalloonPop",
      username: "profh@cmu.edu",
      readonly: false
    )
  end

  desc "Sync development certificates"
  lane :sync_dev_certs do
    UI.user_error!("Please set MATCH_GIT_URL environment variable first!") unless ENV["MATCH_GIT_URL"]

    match(
      git_url: ENV["MATCH_GIT_URL"],
      type: "development",
      app_identifier: "net.cmuis.BalloonPop",
      username: "profh@cmu.edu",
      readonly: true
    )
  end

  desc "Sync App Store certificates"
  lane :sync_appstore_certs do
    UI.user_error!("Please set MATCH_GIT_URL environment variable first!") unless ENV["MATCH_GIT_URL"]

    match(
      git_url: ENV["MATCH_GIT_URL"],
      type: "appstore",
      app_identifier: "net.cmuis.BalloonPop",
      username: "profh@cmu.edu",
      readonly: true
    )
  end

  desc "Create new certificates (admin only)"
  lane :match_new do
    UI.user_error!("Please set MATCH_GIT_URL environment variable first!") unless ENV["MATCH_GIT_URL"]

    match(
      git_url: ENV["MATCH_GIT_URL"],
      type: "appstore",
      app_identifier: "net.cmuis.BalloonPop",
      username: "profh@cmu.edu",
      readonly: false,
      force_for_new_devices: true
    )
  end

  # TestFlight Deployment

  desc "Upload to TestFlight"
  lane :upload_testflight do
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Sync certificates and provisioning profiles if Match is configured
    if ENV["MATCH_GIT_URL"]
      match(
        git_url: ENV["MATCH_GIT_URL"],
        type: "appstore",
        app_identifier: "net.cmuis.BalloonPop",
        username: "profh@cmu.edu",
        readonly: true
      )
    else
      UI.important("⚠️  Match not configured - using Xcode's automatic code signing")
      UI.important("   To use Match, set MATCH_GIT_URL environment variable")
    end

    # Increment the build number
    increment_build_number(
      xcodeproj: "BalloonPop.xcodeproj"
    )

    # Build the app
    build_app(
      scheme: "BalloonPop",
      configuration: "Release",
      export_method: "app-store"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build, upload to TestFlight, and wait for processing"
  lane :beta_wait do
    # Sync certificates and provisioning profiles if Match is configured
    if ENV["MATCH_GIT_URL"]
      match(
        git_url: ENV["MATCH_GIT_URL"],
        type: "appstore",
        app_identifier: "net.cmuis.BalloonPop",
        username: "profh@cmu.edu",
        readonly: true
      )
    else
      UI.important("⚠️  Match not configured - using Xcode's automatic code signing")
      UI.important("   To use Match, set MATCH_GIT_URL environment variable")
    end

    # Increment the build number
    increment_build_number(
      xcodeproj: "BalloonPop.xcodeproj"
    )

    # Build the app
    build_app(
      scheme: "BalloonPop",
      configuration: "Release",
      export_method: "app-store"
    )

    # Upload to TestFlight and wait for processing
    upload_to_testflight
  end
end
