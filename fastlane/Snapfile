# Screenshot configuration for BalloonPop

# Devices to capture screenshots from
devices([
  "iPhone 17"
])

# Languages to capture (can add more for localization)
languages([
  "en-US"
])

# The UI test scheme
scheme("BalloonPop")

# Where screenshots are stored
output_directory("./fastlane/screenshots")

# Clear previous screenshots before creating new ones
clear_previous_screenshots(true)

